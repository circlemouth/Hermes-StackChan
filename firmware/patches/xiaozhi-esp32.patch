+thread_local McpServer::WorkItem* McpServer::current_work_ = nullptr;
+
+bool McpServer::HasWorkContext() { return current_work_ != nullptr; }
+
+bool McpServer::WorkCancelled() {
+    return current_work_ && !current_work_->live(GetInstance().connection_generation(), esp_timer_get_time() / 1000);
+}
+void McpServer::DeferWorkCompletion(std::function<void()> action) {
+    if (!current_work_ || WorkCancelled()) throw std::runtime_error("MCP work cancelled or expired");
+    current_work_->completion = std::move(action);
+}
+bool McpServer::StartWorker() {
+    std::lock_guard<std::mutex> lock(worker_init_mutex_);
+    if (work_queue_) return true;
+    work_queue_ = xQueueCreate(1, sizeof(WorkItem*)); // One active + one pending, no unbounded threads.
+    if (!work_queue_) return false;
+    if (xTaskCreate([](void* context) { static_cast<McpServer*>(context)->WorkerLoop(); },
+                    "mcp_io", 12288, this, 3, nullptr) != pdPASS) {
+        vQueueDelete(work_queue_);
+        work_queue_ = nullptr;
+        return false;
+    }
+    return true;
+}
+void McpServer::WorkerLoop() {
+    while (true) {
+        WorkItem* raw = nullptr;
+        if (xQueueReceive(work_queue_, &raw, portMAX_DELAY) != pdTRUE) continue;
+        auto work = std::shared_ptr<WorkItem>(raw);
+        current_work_ = work.get();
+        std::string result, error;
+        try {
+            if (WorkCancelled()) throw std::runtime_error("MCP work cancelled or expired");
+            result = work->tool->Call(work->arguments);
+            if (WorkCancelled()) throw std::runtime_error("MCP work cancelled or expired");
+        } catch (const std::exception& e) { error = e.what(); }
+        current_work_ = nullptr;
+        Application::GetInstance().Schedule([this, work, result = std::move(result), error = std::move(error)]() {
+            if (work->generation != connection_generation()) return;
+            if (esp_timer_get_time() / 1000 >= work->deadline_ms) {
+                ReplyError(work->id, "MCP work timed out");
+                return;
+            }
+            if (!error.empty()) { ReplyError(work->id, error); return; }
+            try {
+                // UI effects and protocol replies belong to the app main task.
+                if (work->completion) work->completion();
+                ReplyResult(work->id, result);
+            } catch (const std::exception& e) { ReplyError(work->id, e.what()); }
+        });
+    }
 }
 
