diff --git a/main/runtime_safety.h b/main/runtime_safety.h
new file mode 100644
index 0000000..b09e63f
--- /dev/null
+++ b/main/runtime_safety.h
@@ -0,0 +1,188 @@
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include "websocket_endpoint_policy.h"
+
+namespace runtime_safety {
+// One coherent state prevents a concurrent abort from reopening admission while
+// a start callback is resetting the decoder. Reset must happen between Begin/Admit.
+class TtsAdmission {
+    std::atomic<unsigned> state_{0}; // generation above two bits: stopped/preparing/accepted
+    unsigned Advance(unsigned phase) {
+        unsigned old = state_.load(), next;
+        do { next = (((old >> 2) + 1) << 2) | phase; }
+        while (!state_.compare_exchange_weak(old, next));
+        return next >> 2;
+    }
+public:
+    unsigned Begin() { return Advance(1); }
+    bool Admit(unsigned generation) {
+        unsigned expected = (generation << 2) | 1;
+        return state_.compare_exchange_strong(expected, (generation << 2) | 2);
+    }
+    unsigned Stop() { return state_.fetch_and(~3u) >> 2; }
+    void Cancel() { (void)Advance(0); }
+    bool accepts() const { return (state_.load() & 3) == 2; }
+    unsigned generation() const { return state_.load() >> 2; }
+};
+struct WorkToken {
+    unsigned generation = 0;
+    int64_t deadline_ms = 0;
+    bool live(unsigned current_generation, int64_t now_ms) const {
+        return generation == current_generation && now_ms < deadline_ms;
+    }
+};
+template<class F> struct ScopeExit {
+    F fn;
+    explicit ScopeExit(F f) : fn(f) {}
+    ~ScopeExit() { fn(); }
+    ScopeExit(const ScopeExit&) = delete;
+};
+template<class Owner> class OwnedLock {
+    Owner* owner_;
+    bool acquired_;
+public:
+    OwnedLock(Owner* owner, int timeout_ms) : owner_(owner), acquired_(owner && owner->Lock(timeout_ms)) {}
+    ~OwnedLock() { Release(); }
+    explicit operator bool() const { return acquired_; }
+    void Release() { if (acquired_) { owner_->Unlock(); acquired_ = false; } }
+    OwnedLock(const OwnedLock&) = delete;
+    OwnedLock& operator=(const OwnedLock&) = delete;
+};
+// Failed reads are owned by the reading task: another task's successful read
+// cannot authorize an RMW based on fabricated data. Fixed storage avoids allocation
+// on the failure path; overflow conservatively blocks writes until restart.
+class FailedReadGate {
+    std::array<uintptr_t, 16> tasks_{};
+    bool overflow_ = false;
+public:
+    bool may_write(uintptr_t task) const { return !overflow_ && std::find(tasks_.begin(), tasks_.end(), task) == tasks_.end(); }
+    void fail(uintptr_t task) {
+        if (!may_write(task)) return;
+        auto slot = std::find(tasks_.begin(), tasks_.end(), uintptr_t(0));
+        if (slot == tasks_.end() || task == 0) overflow_ = true;
+        else *slot = task;
+    }
+    void recover(uintptr_t task) { for (auto& failed : tasks_) if (failed == task) failed = 0; }
+};
+inline bool ContainsJsonNul(std::string_view json) {
+    for (size_t p = 0; p < json.size(); ++p) {
+        if (json[p] == '\0') return true;
+        if (json[p] == '\\' && p + 1 < json.size()) {
+            ++p; // skip escaped backslash and quoted characters, but reject decoded NUL
+            if (json[p] == 'u' && json.substr(p + 1, 4) == "0000") return true;
+        }
+    }
+    return false;
+}
+struct BinaryAudioView {
+    const uint8_t* payload = nullptr;
+    size_t size = 0;
+    uint32_t timestamp = 0;
+};
+inline bool ParseBinaryAudio(const char* data, size_t len, int version, BinaryAudioView& out) {
+    out = {};
+    if (!data || !len || len > 16384 + 16) return false;
+    const auto* bytes = reinterpret_cast<const uint8_t*>(data);
+    const auto be32 = [](const uint8_t* p) { return (uint32_t(p[0]) << 24) | (uint32_t(p[1]) << 16) | (uint32_t(p[2]) << 8) | p[3]; };
+    size_t header = 0, payload = len;
+    uint32_t timestamp = 0;
+    if (version == 2) {
+        header = 16;
+        if (len < header || bytes[0] != 0 || bytes[1] != 2 || bytes[2] != 0 || bytes[3] != 0) return false;
+        timestamp = be32(bytes + 8); payload = be32(bytes + 12);
+    } else if (version == 3) {
+        header = 4;
+        if (len < header || bytes[0] != 0) return false;
+        payload = (size_t(bytes[2]) << 8) | bytes[3];
+    }
+    if (!payload || payload > 16384 || payload != len - header) return false;
+    out = {bytes + header, payload, timestamp};
+    return true;
+}
+inline bool ValidCameraBuffer(size_t index, size_t count, size_t used, size_t capacity, size_t expected) {
+    return index < count && used > 0 && used <= capacity && used <= 2 * 1024 * 1024 && (!expected || used == expected);
+}
+inline bool ValidCredential(std::string_view value) {
+    // Spaces are credential bytes, not formatting. Reject controls, never trim.
+    for (unsigned char c : value) if (c < 0x20 || c == 0x7f) return false;
+    return true;
+}
+inline std::string SelectWebsocketUrl(const std::string& override_url, const std::string& legacy_url) {
+    const auto& selected = override_url.empty() ? legacy_url : override_url;
+    return ValidWebsocketUrl(selected) ? selected : std::string();
+}
+inline std::string WebsocketScheme(std::string_view url) {
+    if (!ValidWebsocketUrl(url)) return "";
+    return url.substr(0, 5) == "ws://" ? "ws" : "wss";
+}
+inline std::string WebsocketHost(std::string_view url) {
+    auto start = url.find("://");
+    if (start == std::string_view::npos) return "";
+    start += 3;
+    auto authority = url.substr(start, url.find_first_of("/?#", start) - start);
+    auto at = authority.rfind('@');
+    if (at != std::string_view::npos) authority.remove_prefix(at + 1);
+    if (authority.empty()) return "";
+    if (authority.front() == '[') {
+        auto end = authority.find(']');
+        return end == std::string_view::npos ? "" : std::string(authority.substr(0, end + 1));
+    }
+    return std::string(authority.substr(0, authority.find(':')));
+}
+
+inline bool PreviewDimensions(const uint8_t* bytes, size_t length, size_t& width, size_t& height) {
+    width = height = 0;
+    if (!bytes) return false;
+    const std::array<uint8_t, 8> png_signature{0x89, 'P', 'N', 'G', '\r', '\n', 0x1a, '\n'};
+    if (length >= 33 && std::equal(png_signature.begin(), png_signature.end(), bytes)) {
+        if (bytes[8] || bytes[9] || bytes[10] || bytes[11] != 13 ||
+            bytes[12] != 'I' || bytes[13] != 'H' || bytes[14] != 'D' || bytes[15] != 'R') return false;
+        auto be32 = [](const uint8_t* p) { return (uint32_t(p[0]) << 24) | (uint32_t(p[1]) << 16) |
+                                               (uint32_t(p[2]) << 8) | p[3]; };
+        width = be32(bytes + 16); height = be32(bytes + 20);
+    } else if (length >= 4 && bytes[0] == 0xff && bytes[1] == 0xd8) {
+        size_t p = 2;
+        while (p + 4 <= length) {
+            if (bytes[p++] != 0xff) return false;
+            while (p < length && bytes[p] == 0xff) ++p;
+            if (p >= length) return false;
+            const uint8_t marker = bytes[p++];
+            if (marker == 0xd9 || marker == 0xda) return false;
+            if (marker == 0x01 || (marker >= 0xd0 && marker <= 0xd8)) continue;
+            if (p + 2 > length) return false;
+            const size_t segment = (size_t(bytes[p]) << 8) | bytes[p + 1];
+            if (segment < 2 || segment > length - p) return false;
+            if (marker >= 0xc0 && marker <= 0xcf && marker != 0xc4 && marker != 0xc8 && marker != 0xcc) {
+                if (segment < 8) return false;
+                height = (size_t(bytes[p + 3]) << 8) | bytes[p + 4];
+                width = (size_t(bytes[p + 5]) << 8) | bytes[p + 6];
+                break;
+            }
+            p += segment;
+        }
+    }
+    // Bound both axes and decoded allocation BEFORE invoking a decoder.
+    return width > 0 && height > 0 && width <= 1024 && height <= 1024 && width * height <= 320 * 240;
+}
+
+struct VolumeLease {
+    std::string owner;
+    int saved_volume = 70;
+    int64_t expires_ms = 0;
+    bool active() const { return !owner.empty(); }
+    bool expired(int64_t now) const { return active() && now >= expires_ms; }
+    bool accepts(const std::string& id) const { return !active() || owner == id; }
+    void acquire(const std::string& id, int current_volume, int duration_ms, int64_t now) {
+        if (!active()) saved_volume = current_volume;
+        owner = id; expires_ms = now + duration_ms;
+    }
+    void clear() { owner.clear(); expires_ms = 0; }
+};
+}  // namespace runtime_safety
