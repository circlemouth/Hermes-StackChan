+void Application::ProbeStartupConnection() {
+    if (!startup_connection_probe_pending_) {
+        return;
+    }
+    startup_connection_probe_pending_ = false;
+
+    if (!protocol_) {
+        ESP_LOGW(TAG, "Skip startup websocket probe: protocol is not initialized");
+        return;
+    }
+
+    if (protocol_->IsAudioChannelOpened()) {
+        ESP_LOGI(TAG, "Skip startup websocket probe: audio channel is already open");
+        return;
+    }
+
+    if (GetDeviceState() != kDeviceStateIdle) {
+        ESP_LOGW(TAG, "Skip startup websocket probe: device state is %d", static_cast<int>(GetDeviceState()));
+        return;
+    }
+
+    ESP_LOGI(TAG, "Opening persistent local websocket session on HERMES startup");
+    SetDeviceState(kDeviceStateConnecting);
+    Schedule([this]() {
+        ContinueStartupConnectionProbe();
+    });
+}
+
+void Application::ContinueStartupConnectionProbe() {
+    if (GetDeviceState() != kDeviceStateConnecting) {
+        return;
+    }
+
+    reconnect_requested_ = true;
+    if (!protocol_ || !protocol_->OpenAudioChannel()) {
+        ESP_LOGW(TAG, "Startup websocket probe failed");
+        if (protocol_) {
+            protocol_->CloseAudioChannel(false);
         }
+        SetDeviceState(kDeviceStateIdle);
+        ScheduleAudioChannelReconnect();
+        return;
     }
+
+    ESP_LOGI(TAG, "Startup websocket probe connected; entering listening mode");
+    SetListeningMode(GetDefaultListeningMode());
+}
