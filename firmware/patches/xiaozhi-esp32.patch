+void Application::ScheduleAudioChannelReconnect() {
+    if (!reconnect_requested_ || reconnect_timer_handle_ == nullptr || !protocol_) {
+        return;
+    }
+
+    // Coalesce a failed open and its asynchronous disconnect notification.
+    if (esp_timer_is_active(reconnect_timer_handle_)) {
+        return;
+    }
+
+    const uint32_t delay_ms = reconnect_delay_ms_;
+    esp_err_t result = esp_timer_start_once(
+        reconnect_timer_handle_, static_cast<uint64_t>(delay_ms) * 1000ULL);
+    if (result != ESP_OK) {
+        ESP_LOGE(TAG, "Failed to schedule HERMES reconnect: %d", static_cast<int>(result));
+        return;
+    }
+
+    reconnect_delay_ms_ = std::min<uint32_t>(delay_ms * 2, 30000);
+    ESP_LOGI(TAG, "HERMES reconnect scheduled in %u ms", static_cast<unsigned>(delay_ms));
+}
+
+void Application::CancelAudioChannelReconnect() {
+    reconnect_requested_ = false;
+    reconnect_delay_ms_ = 1000;
+    if (reconnect_timer_handle_ != nullptr && esp_timer_is_active(reconnect_timer_handle_)) {
+        esp_timer_stop(reconnect_timer_handle_);
+    }
+}
