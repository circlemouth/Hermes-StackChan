@@ -0,0 +1,17 @@
+#pragma once
+#include <settings.h>
+#include "runtime_safety.h"
+
+// One policy for launcher checks, diagnostics, OTA bypass and connection.
+// A nonempty invalid override fails closed, even if legacy NVS is valid.
+// Only a valid legacy url-only endpoint is migrated; never log its contents.
+inline std::string GetEffectiveWebsocketUrl() {
+    Settings settings("websocket", true);
+    const auto override_url = settings.GetString("url_override", "");
+    const auto legacy_url = settings.GetString("url", "");
+    const auto selected_url = runtime_safety::SelectWebsocketUrl(override_url, legacy_url);
+    if (override_url.empty() && !selected_url.empty()) {
+        settings.SetString("url_override", selected_url);
+    }
+    return selected_url;
+}
diff --git a/main/websocket_endpoint_policy.h b/main/websocket_endpoint_policy.h
new file mode 100644
index 0000000..187487d
--- /dev/null
+++ b/main/websocket_endpoint_policy.h
@@ -0,0 +1,164 @@
+#pragma once
+
+#include <cstddef>
+#include <string_view>
+
+namespace runtime_safety {
+inline constexpr std::size_t kMaxWebsocketUrlLength = 2048;
+
+namespace websocket_url_detail {
+inline bool IsDigit(unsigned char c) { return c >= '0' && c <= '9'; }
+inline bool IsAlpha(unsigned char c) {
+    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
+}
+inline int HexValue(unsigned char c) {
+    if (IsDigit(c)) return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+inline bool ValidIpv4(std::string_view address) {
+    std::size_t position = 0;
+    for (unsigned part = 0; part < 4; ++part) {
+        const auto end = address.find('.', position);
+        const auto octet = address.substr(position, end == std::string_view::npos ? end : end - position);
+        if (octet.empty() || octet.size() > 3 || (octet.size() > 1 && octet.front() == '0')) return false;
+        unsigned value = 0;
+        for (unsigned char c : octet) {
+            if (!IsDigit(c)) return false;
+            value = value * 10 + (c - '0');
+        }
+        if (value > 255) return false;
+        if (part == 3) return end == std::string_view::npos;
+        if (end == std::string_view::npos) return false;
+        position = end + 1;
+    }
+    return false;
+}
+
+// RFC 4291 groups, one optional ::, and an optional final dotted IPv4 tail.
+// Pure parsing: no inet_pton, DNS lookup, platform headers, or SDK dependencies.
+inline bool ValidIpv6(std::string_view address) {
+    if (address.empty()) return false;
+    std::size_t position = 0;
+    unsigned groups = 0;
+    bool compressed = false;
+    if (address.front() == ':') {
+        if (address.size() < 2 || address[1] != ':') return false;
+        compressed = true;
+        position = 2;
+    }
+    while (position < address.size()) {
+        const auto end = address.find(':', position);
+        const auto group = address.substr(position, end == std::string_view::npos ? end : end - position);
+        if (group.empty()) return false;
+        if (group.find('.') != std::string_view::npos) {
+            if (end != std::string_view::npos || !ValidIpv4(group)) return false;
+            groups += 2;
+        } else {
+            if (group.size() > 4) return false;
+            for (unsigned char c : group) if (HexValue(c) < 0) return false;
+            ++groups;
+        }
+        if (groups > 8) return false;
+        if (end == std::string_view::npos) break;
+        position = end + 1;
+        if (position == address.size()) return false; // A single trailing colon.
+        if (address[position] == ':') {
+            if (compressed) return false;
+            compressed = true;
+            ++position;
+        }
+    }
+    // Compression must replace at least one group (including the all-zero ::).
+    return compressed ? groups < 8 : groups == 8;
+}
+
+inline bool ValidDnsOrIpv4(std::string_view host) {
+    if (host.empty()) return false;
+    bool numeric = true;
+    for (unsigned char c : host) if (!IsDigit(c) && c != '.') numeric = false;
+    // Do not reinterpret malformed or short-form dotted IPv4 as DNS.
+    if (numeric && host.find('.') != std::string_view::npos) return ValidIpv4(host);
+    if (host.back() == '.') host.remove_suffix(1); // Absolute DNS names are legitimate.
+    if (host.empty() || host.size() > 253) return false;
+    std::size_t position = 0;
+    while (position < host.size()) {
+        const auto end = host.find('.', position);
+        const auto label = host.substr(position, end == std::string_view::npos ? end : end - position);
+        if (label.empty() || label.size() > 63 || label.front() == '-' || label.back() == '-') return false;
+        for (unsigned char c : label) if (!IsAlpha(c) && !IsDigit(c) && c != '-') return false;
+        if (end == std::string_view::npos) return true;
+        position = end + 1;
+    }
+    return false; // Empty final label, e.g. two final dots.
+}
+
+inline bool ValidPort(std::string_view port) {
+    if (port.empty()) return false;
+    unsigned value = 0;
+    for (unsigned char c : port) {
+        if (!IsDigit(c)) return false;
+        value = value * 10 + (c - '0');
+        if (value > 65535) return false; // Bound before another multiplication.
+    }
+    return value != 0;
+}
+
+inline bool ValidAuthority(std::string_view authority) {
+    if (authority.empty() || authority.find('@') != std::string_view::npos) return false;
+    if (authority.front() == '[') {
+        const auto close = authority.find(']');
+        if (close == std::string_view::npos || !ValidIpv6(authority.substr(1, close - 1))) return false;
+        const auto tail = authority.substr(close + 1);
+        return tail.empty() || (tail.front() == ':' && ValidPort(tail.substr(1)));
+    }
+    const auto colon = authority.find(':');
+    if (colon == std::string_view::npos) return ValidDnsOrIpv4(authority);
+    return ValidDnsOrIpv4(authority.substr(0, colon)) && ValidPort(authority.substr(colon + 1));
+}
+
+inline bool IsResourceCharacter(unsigned char c) {
+    if (IsAlpha(c) || IsDigit(c)) return true;
+    // RFC 3986 pchar, plus path separators and query delimiters.
+    return std::string_view("-._~!$&'()*+,;=:@/?").find(static_cast<char>(c)) != std::string_view::npos;
+}
+} // namespace websocket_url_detail
+
+// Validate the original bytes; never trim URLs or normalize credential bytes.
+// Percent-encoded spaces/data in path/query are allowed, but decoded controls are not.
+inline bool ValidWebsocketUrl(std::string_view url) {
+    if (url.empty() || url.size() > kMaxWebsocketUrlLength) return false;
+    std::size_t start = 0;
+    if (url.substr(0, 5) == "ws://") start = 5;
+    else if (url.substr(0, 6) == "wss://") start = 6;
+    else return false;
+
+    for (std::size_t position = 0; position < url.size(); ++position) {
+        const auto c = static_cast<unsigned char>(url[position]);
+        if (c <= 0x20 || c == 0x7f || c == '\\' || c == '#') return false;
+        if (c == '%') {
+            if (url.size() - position < 3) return false;
+            const int high = websocket_url_detail::HexValue(url[position + 1]);
+            const int low = websocket_url_detail::HexValue(url[position + 2]);
+            if (high < 0 || low < 0) return false;
+            const int decoded = high * 16 + low;
+            if (decoded < 0x20 || decoded == 0x7f) return false;
+            position += 2;
+        }
+    }
+
+    const auto end = url.find_first_of("/?", start);
+    if (!websocket_url_detail::ValidAuthority(url.substr(start, end == std::string_view::npos ? end : end - start))) {
+        return false;
+    }
+    if (end != std::string_view::npos) {
+        for (std::size_t position = end; position < url.size(); ++position) {
+            if (url[position] == '%') position += 2; // Already checked above.
+            else if (!websocket_url_detail::IsResourceCharacter(url[position])) return false;
+        }
+    }
+    return true;
+}
+} // namespace runtime_safety
