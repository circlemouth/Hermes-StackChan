+esp_err_t I2cDevice::TryReadRegs(uint8_t reg, uint8_t* buffer, size_t length, int timeout_ms) {
+    std::lock_guard<std::recursive_mutex> lock(transaction_mutex_);
+    timeout_ms = std::clamp(timeout_ms, 1, 1000);
+    esp_err_t err = ESP_FAIL;
+    for (int attempt = 0; attempt < 2; ++attempt) {
+        err = i2c_master_transmit_receive(i2c_device_, &reg, 1, buffer, length, timeout_ms);
+        if (err == ESP_OK) { failed_reads_.recover(reinterpret_cast<uintptr_t>(xTaskGetCurrentTaskHandle())); return ESP_OK; }
+    }
+    std::memset(buffer, 0, length);
+    failed_reads_.fail(reinterpret_cast<uintptr_t>(xTaskGetCurrentTaskHandle()));
+    ++failure_count_;
+    ESP_LOGW(TAG, "Register read failed: reg=0x%02x err=%s", reg, esp_err_to_name(err));
+    return err;
+}
