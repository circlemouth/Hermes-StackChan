+void Application::ContinueStartupConnectionProbe() {
+    if (GetDeviceState() != kDeviceStateConnecting) {
+        return;
+    }
+
+    reconnect_requested_ = true;
+    if (!protocol_ || !protocol_->OpenAudioChannel()) {
+        ESP_LOGW(TAG, "Startup websocket probe failed");
+        if (protocol_) {
+            protocol_->CloseAudioChannel(false);
         }
+        SetDeviceState(kDeviceStateIdle);
+        ScheduleAudioChannelReconnect();
+        return;
     }
+
+    ESP_LOGI(TAG, "Startup websocket probe connected; entering listening mode");
+    SetListeningMode(GetDefaultListeningMode());
+}
