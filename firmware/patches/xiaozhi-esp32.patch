 #define TAG "WS"
 
+namespace {
+
+std::string DescribeWebsocketEndpoint(const std::string& url) {
+    if (url.empty()) {
+        return "empty websocket_url";
+    }
+
+    auto scheme_end = url.find("://");
+    if (scheme_end == std::string::npos || scheme_end == 0) {
+        return "configured websocket endpoint";
+    }
+
+    auto authority_start = scheme_end + 3;
+    auto authority_end = url.find_first_of("/?#", authority_start);
+    std::string authority = url.substr(
+        authority_start,
+        authority_end == std::string::npos ? std::string::npos : authority_end - authority_start);
+    auto credentials_end = authority.rfind('@');
+    if (credentials_end != std::string::npos) {
+        authority = authority.substr(credentials_end + 1);
+    }
+
+    if (authority.empty()) {
+        return "configured websocket endpoint";
+    }
+
+    return url.substr(0, scheme_end) + "://" + authority;
+}
+
+}  // namespace
+
