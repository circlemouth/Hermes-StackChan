PORT=8765
STACKCHAN_CONTROL_PORT=8766
STACKCHAN_CONTROL_HOST=127.0.0.1
STACKCHAN_WS_KEEPALIVE_MS=3000
STACKCHAN_LOCAL_ONLY=true

# Lightweight local RMS VAD for 16 kHz mono PCM decoded from incoming Opus.
STACKCHAN_LOCAL_VAD_ENABLED=true
STACKCHAN_VAD_RMS_THRESHOLD=0.025
STACKCHAN_VAD_START_SPEECH_MS=60
STACKCHAN_VAD_END_SILENCE_MS=650
STACKCHAN_VAD_MIN_SPEECH_MS=300
STACKCHAN_VAD_PREROLL_MS=1200
STACKCHAN_IGNORE_SHORT_TRANSCRIPTS=true
# STACKCHAN_IGNORED_SHORT_TRANSCRIPTS=あ,あっ,あー,え,えっ,えー

# Barge-in uses a stricter RMS VAD only while TTS is streaming.
STACKCHAN_BARGE_IN_ENABLED=true
STACKCHAN_BARGE_IN_RMS_THRESHOLD=0.50
STACKCHAN_BARGE_IN_START_SPEECH_MS=180
STACKCHAN_BARGE_IN_MIN_SPEECH_MS=240
STACKCHAN_BARGE_IN_IGNORE_TTS_START_MS=900

# TTS replies are split into sentence-sized segments before synthesis.
STACKCHAN_STREAM_LLM_TTS=true
STACKCHAN_MAX_SPEECH_CHARS=240
STACKCHAN_TTS_SEGMENT_MAX_CHARS=90
STACKCHAN_TTS_MAX_SEGMENTS=4
STACKCHAN_REPLY_PROMPT_PREFIX=音声会話です。日本語で1文、30文字以内。聞き返す時も短く。
STACKCHAN_AUTO_RESUME_LISTENING=true

# Hardware voice-loop probe defaults. The JBL sink id changes when Bluetooth
# reconnects, so the probe resolves the speaker by name and sets a conservative
# volume before each run.
STACKCHAN_PROBE_PLAY_TARGET_NAME=JBL Flip 3
STACKCHAN_PROBE_PLAY_VOLUME=0.35
STACKCHAN_PROBE_PROMPT_LEAD_SILENCE_MS=800
# STACKCHAN_PROBE_STT_API_KEY=

# Subtle automatic LED state display. Manual LED tool calls are held briefly.
STACKCHAN_AUTO_LED_ENABLED=true
STACKCHAN_AUTO_LED_MANUAL_HOLD_MS=8000

# Connect to an already-running Hermes Dashboard/TUI on the same host.
HERMES_CONNECT_MODE=dashboard_ws
HERMES_DASHBOARD_URL=http://127.0.0.1:9119
# HERMES_DASHBOARD_TOKEN=
HERMES_TURN_TIMEOUT_MS=600000
HERMES_LOCAL_STT_LANGUAGE=ja
# Optional OpenAI-compatible STT endpoint. Leave unset to use Hermes transcription_tools.
# HERMES_STT_URL=http://127.0.0.1:52626/v1/audio/transcriptions
# HERMES_STT_MODEL=whisper-1
# HERMES_STT_API_KEY=

# HermesAgent root/Python are still used for STT/TTS helper modules and
# as the fallback LLM transport when HERMES_CONNECT_MODE is not dashboard_ws.
HERMES_ROOT=../hermes-agent
HERMES_PYTHON=python3
