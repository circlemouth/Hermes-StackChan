PORT=8765
STACKCHAN_CONTROL_PORT=8766
STACKCHAN_CONTROL_HOST=127.0.0.1
STACKCHAN_WS_KEEPALIVE_MS=3000
STACKCHAN_LOCAL_ONLY=true

# Lightweight local RMS VAD for 16 kHz mono PCM decoded from incoming Opus.
STACKCHAN_MAX_RECORDING_MS=15000
STACKCHAN_LOCAL_VAD_ENABLED=true
STACKCHAN_VAD_RMS_THRESHOLD=0.025
STACKCHAN_VAD_START_SPEECH_MS=60
STACKCHAN_VAD_END_SILENCE_MS=650
STACKCHAN_VAD_MIN_SPEECH_MS=240
STACKCHAN_VAD_PREROLL_MS=360
STACKCHAN_POST_TTS_COOLDOWN_MS=1000
STACKCHAN_IGNORE_SHORT_TRANSCRIPTS=true
# STACKCHAN_IGNORED_SHORT_TRANSCRIPTS=あ,あっ,あー,え,えっ,えー

# Barge-in uses a stricter RMS VAD only while TTS is streaming.
STACKCHAN_BARGE_IN_ENABLED=false
STACKCHAN_BARGE_IN_RMS_THRESHOLD=0.75
STACKCHAN_BARGE_IN_START_SPEECH_MS=360
STACKCHAN_BARGE_IN_MIN_SPEECH_MS=420
STACKCHAN_BARGE_IN_IGNORE_TTS_START_MS=1800

# TTS replies are split into sentence-sized segments before synthesis.
STACKCHAN_STREAM_LLM_TTS=true
STACKCHAN_MAX_SPEECH_CHARS=28
STACKCHAN_TTS_SEGMENT_MAX_CHARS=28
STACKCHAN_TTS_MAX_SEGMENTS=1
STACKCHAN_TTS_PREROLL_MS=600
STACKCHAN_TTS_OUTPUT_GAIN=0.65
# buffer uses the guarded OpusScript heap-copy encoder; int16 keeps the legacy public encode path only for hardware A/B diagnosis.
STACKCHAN_OPUS_PCM_INPUT=buffer
STACKCHAN_MAX_DURATION_STT_RMS_THRESHOLD=0.006
STACKCHAN_FAST_ACK_ENABLED=true
STACKCHAN_FAST_ACK_TEXT=はい。
STACKCHAN_FAST_ACK_TEXTS=はい。|うん。|了解。|なるほど。|わかった。|OK。
STACKCHAN_STOP_LLM_AFTER_MAX_SPOKEN_SEGMENTS=true
STACKCHAN_REPLY_PROMPT_PREFIX=音声会話です。原則1文・14文字以内で短く自然に返して。長さ指定が聞こえても、長く話し続けず必要なら「もう一度。」だけ返して。冗長にしない。
STACKCHAN_AUTO_RESUME_LISTENING=true

# Hardware voice-loop probe defaults. The JBL sink id changes when Bluetooth
# reconnects, so the probe resolves the speaker by name and sets a conservative
# volume before each run.
STACKCHAN_PROBE_PLAY_TARGET_NAME=JBL Flip 3
STACKCHAN_PROBE_PLAY_VOLUME=0.35
STACKCHAN_PROBE_PROMPT_LEAD_SILENCE_MS=800
STACKCHAN_PROBE_PROMPT_WARMUP_TONE_MS=0
STACKCHAN_PROBE_PROMPT_WARMUP_TONE_VOLUME=0.015
STACKCHAN_PROBE_RESPONSE_GUARD_MS=700
STACKCHAN_PROBE_PRE_PROMPT_QUIET_MS=1500
STACKCHAN_PROBE_PRE_PROMPT_QUIET_TIMEOUT_MS=30000
STACKCHAN_PROBE_PRE_PROMPT_QUIET_RMS_THRESHOLD=0.06
STACKCHAN_PROBE_WAIT_BRIDGE_READY=true
STACKCHAN_PROBE_BRIDGE_READY_TIMEOUT_MS=60000
STACKCHAN_PROBE_BRIDGE_READY_POLL_MS=500
# STACKCHAN_PROBE_STT_API_KEY=

# Subtle automatic LED state display. Manual LED tool calls are held briefly.
STACKCHAN_AUTO_LED_ENABLED=true
STACKCHAN_AUTO_LED_MANUAL_HOLD_MS=8000

# Connect to an already-running Hermes Dashboard/TUI on the same host.
HERMES_CONNECT_MODE=dashboard_ws
HERMES_DASHBOARD_URL=http://127.0.0.1:9119
# HERMES_DASHBOARD_TOKEN=
HERMES_TURN_TIMEOUT_MS=600000
# Optional one-shot LLM warmup before opening the device WebSocket listener.
# Useful on an always-on low-spec host to move the cold-start delay to service startup.
STACKCHAN_HERMES_WARMUP_ENABLED=false
STACKCHAN_HERMES_WARMUP_TIMEOUT_MS=20000
HERMES_LOCAL_STT_LANGUAGE=ja
# Optional OpenAI-compatible STT endpoint. Leave unset to use Hermes transcription_tools.
# HERMES_STT_URL=http://127.0.0.1:52626/v1/audio/transcriptions
# HERMES_STT_MODEL=whisper-1
# HERMES_STT_API_KEY=

# Optional low-latency local HTTP TTS endpoint. It must accept UTF-8 text as
# the POST body and return a WAV response. Piper Plus http_server is compatible.
# STACKCHAN_LOCAL_TTS_URL=http://127.0.0.1:18002/?language=ja
STACKCHAN_LOCAL_TTS_TIMEOUT_MS=15000

# Optional host-side speaker output. When the named PipeWire sink is present,
# ai-server plays TTS there, temporarily mutes the M5 speaker, and still sends
# timed audio frames to the M5 for avatar/lip synchronization. If the sink is
# absent or playback setup fails, speech automatically falls back to the M5.
STACKCHAN_LOCAL_TTS_OUTPUT_ENABLED=false
STACKCHAN_LOCAL_TTS_OUTPUT_TARGET_NAME=JBL Flip 3
STACKCHAN_LOCAL_TTS_OUTPUT_VOLUME=0.35
STACKCHAN_LOCAL_TTS_FALLBACK_M5_VOLUME=62

# HermesAgent root/Python are still used for STT/TTS helper modules and
# as the fallback LLM transport when HERMES_CONNECT_MODE is not dashboard_ws.
HERMES_ROOT=../hermes-agent
HERMES_PYTHON=python3
